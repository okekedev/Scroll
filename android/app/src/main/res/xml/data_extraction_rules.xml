<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: saved verses, saved chapters and the chosen translation ride
     along with the system's own backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="scroll.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="scroll.xml" />
    </device-transfer>
</data-extraction-rules>
